# ---------------------------------------------------------
# BirdCanvas
# ---------------------------------------------------------

# Required for artwork generation
OPENAI_API_KEY=replace-with-your-openai-api-key


# ---------------------------------------------------------
# Samsung Frame
# ---------------------------------------------------------

# 0 = do not send artwork to the TV
# 1 = automatically upload and display each new daily artwork
BIRDCANVAS_FRAME_ENABLED=1

# Samsung Frame local IP address
BIRDCANVAS_FRAME_HOST=192.168.1.105

# Pairing token created by the samsungtv CLI
BIRDCANVAS_FRAME_TOKEN_FILE=/home/pi/BirdCanvas/data/frame-token

# Name shown by Samsung when initially authorising the connection
BIRDCANVAS_FRAME_NAME=BirdCanvas
