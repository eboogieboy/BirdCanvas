[Unit]
Description=BirdCanvas %i artwork generation
After=network-online.target canvasos.service
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
Group=__GROUP__
WorkingDirectory=__PROJECT_DIR__
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Europe/London
EnvironmentFile=-__PROJECT_DIR__/.env
ExecStart=__PROJECT_DIR__/.venv/bin/python __PROJECT_DIR__/code/scheduled_job.py %i

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=__PROJECT_DIR__
