[Unit]
Description=CanvasOS Gallery Server
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__PROJECT_DIR__
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Europe/London
ExecStart=__PROJECT_DIR__/.venv/bin/python __PROJECT_DIR__/code/server.py
Restart=always
RestartSec=3
TimeoutStopSec=10
KillSignal=SIGINT

# Basic hardening without preventing library writes.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=__PROJECT_DIR__

[Install]
WantedBy=multi-user.target
